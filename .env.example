# WorkSphere Engine - Environment Configuration Template
# Copy this file to .env and configure local values

# Application Environment
ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=docker

# Gateway & Ports
GATEWAY_PORT=8080
FRONTEND_PORT=5173

# PostgreSQL Master Connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder

# Service Logical Databases
AUTH_DB_NAME=auth_db
ORGANIZATION_DB_NAME=organization_db
EMPLOYEE_DB_NAME=employee_db
PROJECT_TASK_DB_NAME=project_task_db
WORK_MANAGEMENT_DB_NAME=work_management_db
NOTIFICATION_DB_NAME=notification_db
RECRUITMENT_DB_NAME=recruitment_db
ANALYTICS_AUDIT_DB_NAME=analytics_audit_db

# Redis Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka (KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_BOOTSTRAP_SERVERS=localhost:9094

# Security & JWT Configuration
JWT_SECRET=your_base64_encoded_256_bit_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Mail Configuration (MailHog for local development)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@worksphere.dev
